# Copia questo file in .streamlit/secrets.toml (locale, ignorato da git) oppure incolla
# il contenuto in Streamlit Community Cloud > Settings > Secrets.
# Sostituisci i segnaposto con i tuoi valori: non committare mai valori veri.

# Password condivisa per entrare nell'app (se manca, l'app non chiede la password: solo sviluppo locale)
password = "scegli-una-password"

# Stringa di connessione del database (Supabase > Connect > Session pooler)
DATABASE_URL = "postgresql://utente:PASSWORD@host:5432/postgres"

# Chiave API-Football (dashboard.api-football.com)
API_FOOTBALL_KEY = "la-tua-chiave"
